<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Paper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F5F7FB</item>
        <item name="android:navigationBarColor">#F5F7FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Paper.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F5F7FB</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/paper_brand_mark_v1</item>
        <item name="postSplashScreenTheme">@style/Theme.Paper</item>
    </style>
</resources>
